+    def _read_from_shm(self, filename, height, width):
+        try:
+            # Direct path to the Linux shared memory handle
+            path = f"/dev/shm/{filename}"
+            with open(path, "rb") as f:
+                # Map the file into memory
+                mm = mmap.mmap(f.fileno(), 0, prot=mmap.PROT_READ)
+                shm_size = mm.size()
+                expected_bytes = height * width * 3
+                # offset 128 is standard for Isaac Lab/Sim SHM headers
+                logger_mp.warning(
+                f"SHM {filename}: size={shm_size}, expected={expected_bytes}"
+            )
+                if shm_size < expected_bytes:
+                    return None, 0.0
+
+                raw = np.frombuffer(mm, dtype=np.uint8,offset=128, count=921728)
+                return raw.reshape((height, width, 3)).copy(), 30.0     # Return frame and dummy FPS
+        except Exception as e:
+            logger_mp.warning(f"Failed to read image from SHM {filename}: {e}")
+            return None, 0.0
