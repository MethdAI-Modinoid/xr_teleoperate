 import logging_mp
+import mmap
 logger_mp = logging_mp.get_logger(__name__, level=logging_mp.INFO)
 
+def validate_cam_config(cam_config: Dict[str, Any]) -> None:
+    if cam_config is None:
+        raise RuntimeError("Camera config is None")
+
+    required_cameras = ["head_camera", "left_wrist_camera", "right_wrist_camera"]
+
+    for cam_name in required_cameras:
+        if cam_name not in cam_config:
+            raise KeyError(f"Missing '{cam_name}' in camera config")
+
+        cam = cam_config[cam_name]
+
+        if not isinstance(cam.get("enable_zmq", False), bool):
+            raise TypeError(f"{cam_name}.enable_zmq must be bool")
+
+        if cam.get("enable_zmq", False):
+            if "zmq_port" not in cam:
+                raise KeyError(f"{cam_name}.zmq_port missing while ZMQ enabled")
+
+            if not isinstance(cam["zmq_port"], int):
+                raise TypeError(f"{cam_name}.zmq_port must be int")
+
+        if "image_shape" in cam:
+            shape = cam["image_shape"]
+
+            if not isinstance(shape, (list, tuple)):
+                logger_mp.warning(
+                    f"{cam_name}.image_shape is not a list/tuple, got {type(shape)}"
+                )
+                continue
+
+            if len(shape) < 2:
+                raise ValueError(f"{cam_name}.image_shape must have at least H, W")
+
+            if not all(isinstance(x, int) and x > 0 for x in shape[:2]):
+                raise ValueError(f"{cam_name}.image_shape H and W must be positive ints")
+
+            if len(shape) != 3:
+                logger_mp.warning(
+                    f"{cam_name}.image_shape is {shape}, assuming last dim is channels"
+                )
+
+
+
